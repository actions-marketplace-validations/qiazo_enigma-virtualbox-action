{
  "name": "enigma-virtualbox-action",
  "description": "GitHub Action for generating an \"Enigma Virtual Box\" project file.",
  "version": "1.0.1",
  "author": {
    "name": "kjxbyz",
    "email": "hello@kjxbyz.com",
    "url": "https://github.com/kjxbyz"
  },
  "private": true,
  "homepage": "https://github.com/qiazo/enigma-virtualbox-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiazo/enigma-virtualbox-action.git"
  },
  "bugs": {
    "url": "https://github.com/qiazo/enigma-virtualbox-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "tsup",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@insco/enigma-virtualbox": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.8",
    "@github/local-action": "^3.2.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.6",
    "prettier-eslint": "^16.4.1",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
